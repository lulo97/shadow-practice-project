        <mxCell id="O102GTEDFaOgn-5M74sv-101" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Setting&lt;/h1&gt;&lt;p&gt;User can change STT provider if they suspect current model quality too low.&lt;/p&gt;&lt;p&gt;User can change global volume (affect both video and recording audios)&lt;/p&gt;&lt;p&gt;User can change UI style from show one sentence at a time to multiple sentence&lt;/p&gt;&lt;p&gt;User can set loop = ON to listen to one sentence audio repeatedly, helpful for hard audio parts.&lt;/p&gt;" vertex="1">
          <mxGeometry height="205" width="270" x="2950" y="832.5" as="geometry" />
        </mxCell>
